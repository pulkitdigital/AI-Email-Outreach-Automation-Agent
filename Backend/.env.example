# ==============================================================================
# BeBeyond Digital Solutions — AI Email Outreach Automation Agent — Backend
# ==============================================================================

# ------------------------------------------------------------------------------
# App
# ------------------------------------------------------------------------------
NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# ------------------------------------------------------------------------------
# Database (PostgreSQL) — Neon cloud connection
# ------------------------------------------------------------------------------
DATABASE_URL=<PASTE_YOUR_NEON_CONNECTION_STRING_HERE>
# Example format (yours will differ):
# DATABASE_URL=postgresql://neondb_owner:yourpassword@ep-delicate-credit-aybwa0o9.c-5.us-east-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# ------------------------------------------------------------------------------
# Redis (BullMQ queue/scheduler backend) — Upstash cloud connection
# ------------------------------------------------------------------------------
REDIS_URL=<PASTE_YOUR_UPSTASH_TCP_CONNECTION_STRING_HERE>
# ⚠️ Go back to Upstash → TCP tab → make sure "Read-Only Token" is UNCHECKED,
# then copy that string. Username in the URL must be "default", NOT "default_ro".
# Example format (yours will differ):
# REDIS_URL=rediss://default:yourpassword@super-ringtail-191378.upstash.io:6379

# ------------------------------------------------------------------------------
# AI Provider — switch active provider with AI_PROVIDER (gemini | openai)
# ------------------------------------------------------------------------------
AI_PROVIDER=gemini
GEMINI_API_KEY=<GET_FROM_https://aistudio.google.com/apikey>
GEMINI_MODEL=gemini-2.0-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

AI_CATEGORIZATION_MIN_CONFIDENCE=0.5

# ------------------------------------------------------------------------------
# File Storage — local disk for now (no R2/Backblaze credentials needed yet)
# ------------------------------------------------------------------------------
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=bebeyond-outreach
R2_ENDPOINT=
R2_PUBLIC_URL=

STORAGE_PROVIDER=local

# ------------------------------------------------------------------------------
# Google Drive ingestion (optional — only needed if ingesting via Drive links,
# not needed for ZIP/CSV/XLSX upload)
# ------------------------------------------------------------------------------
GOOGLE_SERVICE_ACCOUNT_KEY_FILE=./secrets/drive-service-account.json
GOOGLE_SERVICE_ACCOUNT_KEY_JSON=

MAX_UPLOAD_FILE_SIZE_MB=200
ZIP_MAX_RECURSION_DEPTH=5

# ------------------------------------------------------------------------------
# EMAIL PROVIDER SWITCH
# ------------------------------------------------------------------------------
EMAIL_PROVIDER=brevo

# ------------------------------------------------------------------------------
# Brevo (ACTIVE — transactional email API)
# ------------------------------------------------------------------------------
BREVO_API_KEY=<GET_FROM_Brevo_dashboard_SMTP_and_API_section>
BREVO_SENDER_EMAIL=info@bebeyond.digital
BREVO_SENDER_NAME=BeBeyond Digital Solutions
# The real person outreach reads as being from — used as the email sign-off and folded into the
# Brevo "From" display name (e.g. "Pulkit from BeBeyond"). See config/env.ts for the rationale.
SENDER_PERSON_NAME=Pulkit
BREVO_INBOUND_WEBHOOK_SECRET=
BREVO_INBOUND_WEBHOOK_URL=
BREVO_EVENTS_WEBHOOK_SECRET=

EMAIL_SEND_RATE_LIMIT_MAX=5
EMAIL_SEND_RATE_LIMIT_DURATION_MS=1000

# ------------------------------------------------------------------------------
# Google Workspace / Gmail (STUBBED — skip entirely for now)
# ------------------------------------------------------------------------------
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REDIRECT_URI=
GMAIL_REFRESH_TOKEN=
GMAIL_SENDER_EMAIL=
GOOGLE_CLOUD_PROJECT_ID=
GMAIL_PUBSUB_TOPIC=
GMAIL_PUBSUB_SUBSCRIPTION=

# ------------------------------------------------------------------------------
# Sending limits / scheduler
# ------------------------------------------------------------------------------
DAILY_EMAIL_LIMIT=300
SCHEDULER_TIMEZONE=Asia/Kolkata
SCHEDULER_CRON=0 9 * * *

# Spreads a day's automated sends across a randomized window instead of firing them
# all back-to-back at SCHEDULER_CRON time. 0 disables spreading. See
# Backend/src/modules/scheduler/sendSpread.ts.
SEND_SPREAD_WINDOW_HOURS=4

# Sending-domain warm-up ramp (bebeyond.digital has no prior sending history) — caps
# DAILY_EMAIL_LIMIT to a smaller, growing number for the first days after
# WARMUP_START_DATE instead of sending at full volume immediately. Disabled by
# default. See Backend/src/modules/scheduler/warmup.ts.
WARMUP_ENABLED=false
# YYYY-MM-DD, in SCHEDULER_TIMEZONE. Required when WARMUP_ENABLED=true.
WARMUP_START_DATE=
WARMUP_START_LIMIT=25
# Multiplicative growth per WARMUP_GROWTH_INTERVAL_DAYS — 1.2 = +20%.
WARMUP_GROWTH_RATE=1.2
WARMUP_GROWTH_INTERVAL_DAYS=3

# ------------------------------------------------------------------------------
# Email Composer / unsubscribe links
# ------------------------------------------------------------------------------
PUBLIC_APP_URL=http://localhost:4000
UNSUBSCRIBE_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxx

# ------------------------------------------------------------------------------
# CORS
# ------------------------------------------------------------------------------
ALLOWED_ORIGINS=http://localhost:3000

# ------------------------------------------------------------------------------
# WhatsApp (Meta WhatsApp Cloud API) — channel infrastructure only, not yet wired
# into the Daily Scheduler; sending stays manually triggered from the dashboard
# until Meta Business verification is confirmed live. See
# shared/src/types/whatsapp.ts and Backend/src/providers/whatsapp/.
# ------------------------------------------------------------------------------
# Not read by any code yet — MetaCloudWhatsAppProvider is the only implementation
# (Backend/src/providers/whatsapp/index.ts has no switch). Present for a future
# second provider, mirroring EMAIL_PROVIDER's switch.
WHATSAPP_PROVIDER=meta_cloud
WHATSAPP_ACCESS_TOKEN=<GET_FROM_Meta_Business_Manager_System_User_permanent_token>
WHATSAPP_PHONE_NUMBER_ID=<GET_FROM_Meta_App_Dashboard_WhatsApp_API_Setup>
WHATSAPP_BUSINESS_ACCOUNT_ID=<GET_FROM_Meta_Business_Manager>
# Any random string you choose — enter this same value in the Meta App Dashboard's
# webhook subscription config (GET /webhooks/whatsapp verification handshake).
WHATSAPP_WEBHOOK_VERIFY_TOKEN=<CHOOSE_ANY_RANDOM_STRING>
WHATSAPP_APP_SECRET=<GET_FROM_Meta_App_Dashboard_Settings_Basic>
# The business number the click-to-WhatsApp link (wa.me) points to — digits only,
# country code included, no '+'. Read by Backend/src/modules/whatsapp/clickToWhatsapp.ts;
# the link silently doesn't render without it, even if WHATSAPP_CTA_ENABLED=true.
WHATSAPP_BUSINESS_NUMBER=<YOUR_WHATSAPP_BUSINESS_NUMBER_DIGITS_ONLY_WITH_COUNTRY_CODE>
# Gates the click-to-WhatsApp link in outbound emails — leave false until Meta
# Business verification is confirmed live.
WHATSAPP_CTA_ENABLED=false